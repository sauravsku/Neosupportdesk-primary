spring:
  application:
    name: CentNeoSupportDeskSvc
  profiles:
    active: prod  # Set active profile
  mvc:
    servlet:
      path: /api/primary

server:
  port: 9002

supportDeskAuthSvc:
  base-url: ${AUTH_BASE_URL}

gitlab:
  dlp:
    token: ${GITLAB_DLP_ACCESS_TOKEN}
  omni:
    token: ${GITLAB_OMNI_ACCESS_TOKEN}
  kyc:
    token: ${GITLAB_KYC_ACCESS_TOKEN}

  webhook-secret: ${GITLAB_WEBHOOK_SECRET}
  url: ${GITLAB_URL}

cors:
  allowed_origins: ${CORS_ALLOWED_ORIGINS}


# how often scheduler runs (ms)
userSync:
  scheduler:
    delay-ms: 30000  #1HR

assignee:
  scheduler:
    delay-ms: 30000  #30SECS
    batch-size: 20 # how many pending tickets to process per level each run

escalation:
  scheduler:
    delay-ms: 30000 #5Mins


jwt:
  public-key-file: classpath:keys/jwt_public_key.pem
  issuer: centneo


aws:
  endpoint-url: ${AWS_ENDPOINT_URL}
  region: ${AWS_REGION} # change to your region
  bucket: ${AWS_BUCKET_NAME} # change to your bucket
  access-key: ${AWS_ACCESS_KEY}
  secret-key: ${AWS_SECRET_KEY}
  presign-expiration-minutes: 15


logging:
  level:
    org.springframework: INFO
    com.centNeo: DEBUG
    org.springframework.security: TRACE
    org.springframework.ldap: TRACE
    org.springframework.security.ldap: TRACE
    #org.hibernate.orm.jdbc.bind: TRACE
    #org.hibernate.type.descriptor.sql: TRACE
    #org.hibernate.loader.plan.exec.process.internal: TRACE


